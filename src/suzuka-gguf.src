#!/usr/bin/env python3
"""
suzuka-gguf - simple llama CLI

A small, intentionally boring GGUF manager for llama.cpp.

By default, suzuka-gguf uses its own local cache and does not modify
the caller's LLAMA_CACHE environment. Use --cache to inspect or use
an existing llama.cpp cache explicitly.

Examples:
suzuka-gguf list
suzuka-gguf info ggml-org/gemma-4-E4B-it-GGUF
suzuka-gguf pull ggml-org/gemma-4-E4B-it-GGUF:Q4_0
suzuka-gguf remove ggml-org/gemma-4-E4B-it-GGUF
suzuka-gguf load ggml-org/gemma-4-E4B-it-GGUF
suzuka-gguf unload
suzuka-gguf call "hello"
"""


from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path


DEFAULT_CACHE = Path(__file__).resolve().parent / "models"
STATE_DIR = Path.home() / ".local" / "state" / "suzuka-gguf"
CACHE_OVERRIDE: Path | None = None
STATE_FILE = STATE_DIR / "server.json"
DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 8080


def cache_root() -> Path:
    if CACHE_OVERRIDE is not None:
        return CACHE_OVERRIDE.expanduser()
    return DEFAULT_CACHE


def repo_dir(repo: str) -> Path:
    if "/" not in repo or repo.startswith("/") or ".." in Path(repo).parts:
        raise ValueError(f"invalid repository name: {repo!r}")
    org, model = repo.split("/", 1)
    return cache_root() / f"models--{org}--{model}"

def repo_from_dir(path: Path) -> str | None:
    name = path.name
    if not name.startswith("models--"):
        return None
    rest = name[len("models--"):]
    if "--" not in rest:
        return None
    org, model = rest.split("--", 1)
    return f"{org}/{model}"

def get_cached_repositories() -> list[tuple[str, Path]]:
    root = cache_root()

    if not root.is_dir():
        return []

    repos = []

    for path in root.iterdir():
        if path.is_dir():
            repo = repo_from_dir(path)
            if repo:
                repos.append((repo, path))

    return sorted(repos)


def find_cached_file(filename: str) -> Path:
    matches = []

    for _, repo_path in get_cached_repositories():
        info = latest_snapshot(repo_path)
        if not info:
            continue

        _, snapshot = info

        for file in snapshot_files(snapshot):
            if file.name == filename:
                matches.append(file)

    if not matches:
        raise FileNotFoundError(f"file is not cached: {filename}")

    if len(matches) > 1:
        raise RuntimeError(
            f"multiple cached files found for {filename}; "
            "use <user>/<model> <file>"
        )

    return matches[0]


def latest_snapshot(repo_path: Path) -> tuple[str, Path] | None:
    refs = repo_path / "refs"
    main = refs / "main"

    if main.is_file():
        commit = main.read_text(encoding="utf-8").strip()
        snapshot = repo_path / "snapshots" / commit
        if snapshot.is_dir():
            return commit, snapshot

    snapshots = repo_path / "snapshots"
    if not snapshots.is_dir():
        return None

    dirs = [p for p in snapshots.iterdir() if p.is_dir()]
    if not dirs:
        return None

    snapshot = max(dirs, key=lambda p: p.stat().st_mtime)
    return snapshot.name, snapshot


def human_size(n: int) -> str:
    value = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if value < 1024 or unit == "TiB":
            return f"{value:.1f} {unit}"
        value /= 1024
    return f"{n} B"


def directory_size(path: Path) -> int:
    total = 0
    if not path.exists():
        return 0

    for p in path.rglob("*"):
        try:
            if p.is_file() and not p.is_symlink():
                total += p.stat().st_size
        except OSError:
            pass
    return total


def snapshot_files(snapshot: Path) -> list[Path]:
    return sorted(
        (p for p in snapshot.rglob("*") if p.is_file()),
        key=lambda p: str(p.relative_to(snapshot)),
    )


def cached_model_file(repo: str, filename: str | None) -> Path:
    path = repo_dir(repo)
    if not path.is_dir():
        raise FileNotFoundError(f"model is not cached: {repo}")

    info = latest_snapshot(path)
    if not info:
        raise FileNotFoundError(f"no snapshot found for: {repo}")

    _, snapshot = info

    if filename:
        candidate = snapshot / filename
        if candidate.is_file():
            return candidate
        raise FileNotFoundError(f"file is not cached: {repo}/{filename}")

    files = snapshot_files(snapshot)
    ggufs = [p for p in files if p.name.endswith(".gguf") and "mmproj" not in p.name]
    if len(ggufs) == 1:
        return ggufs[0]

    if not ggufs:
        raise FileNotFoundError(f"no GGUF model file found in: {repo}")

    raise RuntimeError(
        f"multiple GGUF files found in {repo}; use the explicit file form "
        f"<user>/<model>/<file>.gguf"
    )


def read_state() -> dict | None:
    try:
        return json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def write_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")


def clear_state() -> None:
    try:
        STATE_FILE.unlink()
    except FileNotFoundError:
        pass


def server_is_alive(state: dict | None) -> bool:
    if not state:
        return False

    pid = state.get("pid")
    if not isinstance(pid, int):
        return False

    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def server_url(state: dict) -> str:
    return f"http://{state['host']}:{state['port']}"


def wait_for_server(url: str, process: subprocess.Popen, timeout: float = 60.0) -> None:
    deadline = time.monotonic() + timeout

    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError(
                f"llama-server exited before becoming ready (code {process.returncode})"
            )

        try:
            with urllib.request.urlopen(url + "/health", timeout=1) as response:
                if response.status == 200:
                    return
        except (urllib.error.URLError, TimeoutError, OSError):
            pass

        time.sleep(0.25)

    process.terminate()
    raise TimeoutError(f"llama-server did not become ready within {timeout:.0f}s")


def cmd_list(args: argparse.Namespace) -> int:
    root = cache_root()
    print(f"Cache: {root}")

    if args.detail:
        print()

    repos = get_cached_repositories()

    if not repos:
        print("No cached repositories.")
        return 0

    for repo, path in sorted(repos):
        info = latest_snapshot(path)
        ctx = f"- {repo}" if not args.detail else repo
        if not info:
            print(ctx)
            if args.detail:
                print("  No snapshot found.")
                print()
            continue

        revision, snapshot = info
        print(ctx + f"  ({revision[:12]})")

        if not args.detail:
            continue

        model_files = [
            file
            for file in snapshot_files(snapshot)
            if file.name.endswith(".gguf") and "mmproj" not in file.name
        ]

        if not model_files:
            print("  No GGUF model files found.")
            print()
            continue

        for file in model_files:
            print(f"  {human_size(file.stat().st_size):>10}  {file.relative_to(snapshot)}")

        print()

    return 0


def cmd_info(args: argparse.Namespace) -> int:
    path = repo_dir(args.repo)

    if not path.exists():
        print(f"Not cached: {args.repo}", file=sys.stderr)
        return 1

    info = latest_snapshot(path)

    print(f"Repository : {args.repo}")
    print(f"Cache path : {path}")
    print(f"Size       : {human_size(directory_size(path))}")

    if not info:
        print("Revision   : -")
        return 0

    revision, snapshot = info
    print(f"Revision   : {revision}")
    print(f"Snapshot   : {snapshot}")

    for file in snapshot_files(snapshot):
        relative = file.relative_to(snapshot)
        target = ""
        if file.is_symlink():
            try:
                target = f" -> {file.readlink()}"
            except OSError:
                pass
        print(f"  {relative}{target}")

    return 0


def cmd_files(args: argparse.Namespace) -> int:
    path = repo_dir(args.repo)

    if not path.exists():
        print(f"Not cached: {args.repo}", file=sys.stderr)
        return 1

    info = latest_snapshot(path)
    if not info:
        print("No snapshot found.", file=sys.stderr)
        return 1

    _, snapshot = info

    for file in snapshot_files(snapshot):
        try:
            size = human_size(file.stat().st_size)
        except OSError:
            size = "-"
        print(f"{size:>10}  {file.relative_to(snapshot)}")

    return 0


def cmd_path(args: argparse.Namespace) -> int:
    if args.repo:
        print(cached_model_file(args.repo, args.file))
    else:
        print(find_cached_file(args.file))
    return 0


def cmd_pull(args: argparse.Namespace) -> int:
    command = ["llama-cli"]

    if ":" in args.target:
        command += ["-hf", args.target]
    else:
        command += ["--hf-repo", args.target]

    if args.no_mmproj:
        command.append("--no-mmproj")

    print("+", " ".join(command))
    print("Note: llama-cli downloads and then exits.")

    env = os.environ.copy()
    env["LLAMA_CACHE"] = str(cache_root())

    process = subprocess.Popen(
        command,
        stdin=subprocess.PIPE,
        env=env,
    )

    process.communicate(b"/exit\n")

    return process.returncode


def cmd_remove(args: argparse.Namespace) -> int:
    path = repo_dir(args.repo)

    if not path.exists():
        print(f"Not cached: {args.repo}", file=sys.stderr)
        return 1

    if not args.yes:
        answer = input(f"Remove cached repository {args.repo}? [y/N] ").strip().lower()
        if answer not in {"y", "yes"}:
            print("Cancelled.")
            return 0

    shutil.rmtree(path)
    print(f"Removed: {args.repo}")
    return 0


def cmd_load(args: argparse.Namespace) -> int:
    repo = args.repo
    filename = args.file
    target = repo if filename is None else f"{repo}/{filename}"

    current = read_state()

    if server_is_alive(current):
        current_target = current.get("model_target", current.get("model_repo"))
        if current_target == target:
            print(f"Already loaded: {target}")
            print(f"API: {server_url(current)}")
            return 0

        print(
            f"Another model is already loaded: {current_target}",
            file=sys.stderr,
        )
        print("Run `suzuka-gguf unload` first.", file=sys.stderr)
        return 1

    model_path = cached_model_file(repo, filename)

    host = args.host
    port = args.port

    command = [
        "llama-server",
        "--model",
        str(model_path),
        "--host",
        host,
        "--port",
        str(port),
    ]

    if args.threads is not None:
        command += ["--threads", str(args.threads)]

    if args.reasoning is not None:
        command += ["--reasoning", args.reasoning]

    log_path = STATE_DIR / "llama-server.log"
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log = log_path.open("wb")

    print(f"Loading: {target}")
    print(f"Model  : {model_path}")
    print(f"API    : http://{host}:{port}")
    print(f"Log    : {log_path}")

    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )

    state = {
        "pid": process.pid,
        "model_repo": repo,
        "model_target": target,
        "model_path": str(model_path),
        "host": host,
        "port": port,
        "command": command,
        "log": str(log_path),
    }
    write_state(state)

    try:
        wait_for_server(f"http://{host}:{port}", process, args.timeout)
    except Exception:
        clear_state()
        log.close()
        raise

    print(f"Loaded: {target}")
    return 0


def cmd_unload(args: argparse.Namespace) -> int:
    state = read_state()

    if not server_is_alive(state):
        clear_state()
        print("No suzuka-gguf model is loaded.")
        return 0

    pid = state["pid"]
    print(f"Stopping llama-server (PID {pid})...")

    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass

    deadline = time.monotonic() + args.timeout

    while time.monotonic() < deadline:
        if not server_is_alive(state):
            clear_state()
            print("Unloaded.")
            return 0
        time.sleep(0.25)

    print("llama-server did not exit; sending SIGKILL.", file=sys.stderr)

    try:
        os.killpg(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass

    deadline = time.monotonic() + 5

    while time.monotonic() < deadline:
        if not server_is_alive(state):
            clear_state()
            print("Unloaded.")
            return 0
        time.sleep(0.1)

    print("Failed to stop llama-server.", file=sys.stderr)
    return 1


def cmd_call(args: argparse.Namespace) -> int:
    state = read_state()

    if not server_is_alive(state):
        print(
            "llama-server is not running. Run `suzuka-gguf load <user>/<model>` first.",
            file=sys.stderr,
        )
        return 1

    url = server_url(state) + "/v1/chat/completions"

    body = {
        "model": state["model_repo"],
        "messages": [{"role": "user", "content": args.prompt}],
        "stream": True,
        "stream_options": {
            "include_usage": True,
        }
    }

    if args.reasoning_effort is not None:
        body["reasoning_effort"] = args.reasoning_effort

    request = urllib.request.Request(
        url,
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    usage = {}
    timings = {}

    elapsed = 0
    start_time = time.monotonic()

    try:
        with urllib.request.urlopen(request, timeout=args.timeout) as response:
            for line in response:
                line = line.decode("utf-8").strip()

                if not line.startswith("data: "):
                    continue

                data = line[6:]

                if data == "[DONE]":
                    break

                chunk = json.loads(data)

                if chunk.get("usage"):
                    usage = chunk["usage"]

                if chunk.get("timings"):
                    timings = chunk["timings"]

                choices = chunk.get("choices", [])
                if not choices:
                    continue

                delta = choices[0].get("delta", {})
                content = delta.get("content", "")

                if content:
                    print(content, end="", flush=True)

    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", errors="replace")
        print(f"API error ({e.code}): {detail}", file=sys.stderr)
        return 1
    except urllib.error.URLError as e:
        print(f"API connection error: {e}", file=sys.stderr)
        return 1

    finally:
        elapsed = time.monotonic() - start_time

    prompt_tokens = usage.get("prompt_tokens")
    completion_tokens = usage.get("completion_tokens")
    predicted_per_second = timings.get("predicted_per_second")

    print()

    print(
        f"["
        + (
            f"prompt={prompt_tokens} tokens"
            if prompt_tokens is not None
            else ""
        )
        + (
            f", completion={completion_tokens} tokens"
            if completion_tokens is not None
            else ""
        )
        + f", total={elapsed:.2f} s"
        + (
            f", {predicted_per_second:.2f} tok/s"
            if predicted_per_second is not None
            else ""
        )
        + "]",
        file=sys.stderr,
    )

    return 0

def cmd_status(args: argparse.Namespace) -> int:
    state = read_state()

    if not server_is_alive(state):
        clear_state()
        print("No suzuka-gguf model is loaded.")
        return 0

    print(f"Model  : {state['model_target']}")
    print(f"Path   : {state['model_path']}")
    print(f"API    : {server_url(state)}")
    print(f"PID    : {state['pid']}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="suzuka-gguf",
        description="my gguf/llama controller",
    )

    parser.add_argument(
        "--cache",
        type=Path,
        help="override cache root (default: <repository>/models)",
    )

    sub = parser.add_subparsers(dest="command", required=True)

    command = sub.add_parser("list", help="list cached repositories")
    command.add_argument("--detail", action="store_true", help="show cached GGUF files")
    command.set_defaults(func=cmd_list)

    command = sub.add_parser("info", help="show repository information")
    command.add_argument("repo")
    command.set_defaults(func=cmd_info)

    command = sub.add_parser("files", help="list files in a repository")
    command.add_argument("repo")
    command.set_defaults(func=cmd_files)

    command = sub.add_parser("path", help="resolve a cached model file path")
    command.add_argument("file")
    command.add_argument("--repo", help="<user>/<model>")
    command.set_defaults(func=cmd_path)

    command = sub.add_parser("pull", help="download a model from Hugging Face")
    command.add_argument("target", help="<user>/<model> or <user>/<model>:<quantize>")
    command.add_argument("--no-mmproj", action="store_true")
    command.set_defaults(func=cmd_pull)

    command = sub.add_parser("remove", help="remove a cached repository")
    command.add_argument("repo")
    command.add_argument("-y", "--yes", action="store_true")
    command.set_defaults(func=cmd_remove)

    command = sub.add_parser("load", help="load one cached model into llama-server")
    command.add_argument("repo", help="<user>/<model>")
    command.add_argument("file", nargs="?", help="GGUF file")
    command.add_argument("--host", default=DEFAULT_HOST)
    command.add_argument("--port", type=int, default=DEFAULT_PORT)
    command.add_argument("--threads", type=int)
    command.add_argument("--reasoning", choices=["on", "off", "auto"], default="auto")
    command.add_argument("--timeout", type=float, default=60)
    command.set_defaults(func=cmd_load)

    command = sub.add_parser("unload", help="stop llama-server and unload the model")
    command.add_argument("--timeout", type=float, default=10)
    command.set_defaults(func=cmd_unload)

    command = sub.add_parser("call", help="call the currently loaded model")
    command.add_argument("prompt")
    command.add_argument("--reasoning-effort")
    command.add_argument("--timeout", type=float, default=300)
    command.set_defaults(func=cmd_call)

    command = sub.add_parser("status", help="show the currently loaded model")
    command.set_defaults(func=cmd_status)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    global CACHE_OVERRIDE
    if args.cache:
        CACHE_OVERRIDE = args.cache.expanduser()

    try:
        return args.func(args)
    except (ValueError, FileNotFoundError, RuntimeError, TimeoutError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
